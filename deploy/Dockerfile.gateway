FROM node:24-bookworm-slim AS frontend
WORKDIR /application
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/index.html frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json frontend/vite.config.ts ./
COPY frontend/src/ ./src/
ENV VITE_API_BASE_URL=/api
RUN npm run build
FROM nginxinc/nginx-unprivileged:stable-alpine
ENV NGINX_ENVSUBST_OUTPUT_DIR=/tmp
COPY --from=frontend /application/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/gateway.conf.template /etc/nginx/templates/default.conf.template
USER 1000:1000
